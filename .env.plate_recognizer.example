# Plate Recognizer API Configuration
# Get your API token from: https://app.platerecognizer.com/

# Required: Your Plate Recognizer API Token
PLATE_RECOGNIZER_API_TOKEN=your_api_token_here

# Optional: API URL (default is the standard Snapshot Cloud endpoint)
# PLATE_RECOGNIZER_API_URL=https://api.platerecognizer.com/v1/plate-reader/

# Optional: Regions for better recognition accuracy (comma-separated)
# Default is 'sa' (Saudi Arabia)
# Available regions: sa, ae, kw, qa, bh, om, and others
# PLATE_RECOGNIZER_REGIONS=sa,ae,kw

# Example for Saudi Arabia only:
# PLATE_RECOGNIZER_REGIONS=sa

# Example for multiple GCC countries:
# PLATE_RECOGNIZER_REGIONS=sa,ae,kw,qa,bh,om
