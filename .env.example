# Flask Configuration
# ⚠️ PRODUCTION SECURITY: Set FLASK_DEBUG=False and FLASK_ENV=production
# ⚠️ أمان الإنتاج: اضبط FLASK_DEBUG=False و FLASK_ENV=production
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=change-this-to-a-random-secret-key-in-production-use-secrets.token_urlsafe(32)

# Server Configuration
HOST=0.0.0.0
PORT=5000

# CORS Configuration (Production)
# Deployment URL (set to your Render/production URL)
DEPLOYMENT_URL=https://housing-management-system-83yt.onrender.com

# Add comma-separated list of additional allowed origins for CORS
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=

# Database Configuration
# For production, use PostgreSQL instead of SQLite
# DATABASE_URL=postgresql://username:password@host:5432/database_name
# For local development with SQLite (default):
# DATABASE_PATH=/path/to/custom/housing.db

# Session Configuration
SESSION_TIMEOUT_HOURS=24

# Plate Recognizer ParkPow API Configuration
# Get your API token from https://app.platerecognizer.com/service/snapshot-cloud/dashboard/
# رمز التطبيقات (API Token): Get from dashboard
PLATE_RECOGNIZER_API_TOKEN=your-api-token-here
PLATE_RECOGNIZER_API_URL=https://api.platerecognizer.com/v1/plate-reader/

# ParkPow API Configuration
# Get your API token from https://app.parkpow.com/accounts/token/
PARKPOW_API_TOKEN=your-parkpow-token-here
PARKPOW_API_URL=https://app.parkpow.com/api/v1
PARKPOW_WEBHOOK_TOKEN=your-webhook-token-here

# Email Configuration
# Configure SMTP settings for email notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
FROM_EMAIL=traffic@university.edu.sa
FROM_NAME=نظام المرور المتكامل

# Security Configuration (Production)
# ⚠️ Enable these in production environment
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
HTTPS_ONLY=True

# Backup Configuration
# For automated backups to S3 (optional)
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RETENTION_DAYS=30

# Logging Configuration
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Rate Limiting (optional)
# RATELIMIT_ENABLED=True
# RATELIMIT_DEFAULT=100/hour
# RATELIMIT_STORAGE_URL=redis://localhost:6379

# Monitoring (optional)
# SENTRY_DSN=your-sentry-dsn-here

# ==============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST / قائمة فحص النشر الإنتاجي
# ==============================================================================
# Before deploying to production, ensure:
# قبل النشر على الإنتاج، تأكد من:
#
# ✅ FLASK_ENV=production
# ✅ FLASK_DEBUG=False
# ✅ SECRET_KEY is randomly generated and secure
# ✅ DATABASE_URL points to production database (PostgreSQL/MySQL)
# ✅ SESSION_COOKIE_SECURE=True (requires HTTPS)
# ✅ All API tokens are set correctly
# ✅ SMTP credentials are configured
# ✅ Backup configuration is set
# ✅ Change all default passwords on first login
# ✅ Setup automated database backups
# ✅ Configure firewall rules
# ✅ Review file permissions
# ✅ Setup logging and monitoring
# ✅ Configure HTTPS with valid SSL certificate
# ==============================================================================

